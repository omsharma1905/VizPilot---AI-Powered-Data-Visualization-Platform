# ==============================================================================
# VizPilot — Environment Configuration Example
# Copy this file to .env.local and replace values with your own credentials.
# NOTE: Never commit .env or .env.local with real secrets to version control.
# ==============================================================================

# MongoDB Atlas or Local MongoDB connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB_NAME=vizpilot

# Session encryption secret (minimum 32 random characters recommended)
SESSION_SECRET=super-secret-vizpilot-entropy-key-change-in-production

# Optional: Groq API Key for LLM-assisted chart recommendations (falls back to heuristic ranking if omitted)
GROQ_API_KEY=

# Optional: Transactional Email API Key for real email verification (uses console logger in development mode)
EMAIL_SERVER_API_KEY=
